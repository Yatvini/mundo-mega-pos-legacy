# Supabase público para el frontend de Vite.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-publica

# API serverless / backend.
# No debe usarse en componentes React ni exponerse al navegador.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-solo-servidor

# Opcional: la API de invitaciones acepta SUPABASE_URL o VITE_SUPABASE_URL.
SUPABASE_URL=https://tu-proyecto.supabase.co
